# TerraScore Environment Configuration
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-this-in-production
APP_NAME=TerraScore API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://terrascore:password@localhost:5432/terrascore
TIMESCALE_URL=postgresql://terrascore:password@localhost:5433/timeseries
DB_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Sentinel Hub (Satellite Data)
SENTINEL_HUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_HUB_CLIENT_SECRET=your-sentinel-hub-client-secret

# Weather API
OPENWEATHER_API_KEY=your-openweather-api-key

# Object Storage (MinIO/S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=your-minio-password
S3_BUCKET_NAME=terrascore-data

# ML Models
ML_MODEL_PATH=/app/ml/models
MLFLOW_TRACKING_URI=http://localhost:5000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring (optional)
SENTRY_DSN=
ENABLE_METRICS=true

# Email (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@terrascore.rs

# Geospatial
DEFAULT_SRID=4326
PARCEL_BUFFER_METERS=10.0
MAX_PARCEL_SIZE_HA=1000.0
MIN_PARCEL_SIZE_HA=0.1

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
